---
import { site } from "../lib/site";
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="kicker">{site.place}</p>
      <p class="footer-author">{site.author}</p>
      <p class="footer-note">
        Markdown en Git. Cada nota alimenta un post de LinkedIn — aquí está la versión que cabe.
      </p>
    </div>
    <p class="footer-year">© {new Date().getFullYear()}</p>
  </div>
</footer>
