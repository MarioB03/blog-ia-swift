---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { formatIndexDate, formatPostDate, isoDate, readingMinutes, site } from "../lib/site";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b, "es"),
);

const featured = posts[0];
const rest = posts.slice(1);
---

<Layout>
  <main class="page">
    <div class="home-grid wrap">
      <aside class="masthead" aria-label="Sobre el sitio">
        <p class="kicker">
          {site.author}
          <span aria-hidden="true"> · </span>
          {site.place}
        </p>
        <p class="masthead-tagline">{site.tagline}</p>
        <p class="masthead-bio">{site.bio}</p>
        <ul class="tags stacked" aria-label="Etiquetas">
          {
            tags.map((tag) => (
              <li>
                <a class="hit-expand" href={`/?tag=${tag}`} data-tag={tag}>
                  {tag}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="count">{posts.length} notas</p>
      </aside>

      <section>
        <div class="section-head" id="archive-head">
          <h2 class="kicker">Notas</h2>
          <a class="clear-filter" id="clear-filter" href="/" hidden>
            Quitar <span class="accent" id="active-tag"></span>
          </a>
        </div>

        {
          featured ? (
            <article class="feature" data-tags={featured.data.tags.join(" ")}>
              <p class="kicker is-accent">
                <time datetime={isoDate(featured.data.date)}>{formatPostDate(featured.data.date)}</time>
                {" · "}
                {readingMinutes(featured.body)} min
              </p>
              <h2 class="feature-title">
                <a class="story-link" href={`/posts/${featured.data.slug}`}>
                  {featured.data.title}
                </a>
              </h2>
              <p class="lede">{featured.data.description}</p>
              <ul class="tags">
                {featured.data.tags.map((tag) => (
                  <li>
                    <a class="hit-expand" href={`/?tag=${tag}`} data-tag={tag}>
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ) : null
        }

        <ol class="post-list">
          {
            rest.map((post) => (
              <li class="index-row" data-tags={post.data.tags.join(" ")}>
                <p class="index-date">
                  <time datetime={isoDate(post.data.date)}>{formatIndexDate(post.data.date)}</time>
                </p>
                <div>
                  <h2>
                    <a class="story-link" href={`/posts/${post.data.slug}`}>
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="excerpt">{post.data.description}</p>
                  <ul class="tags">
                    {post.data.tags.map((tag) => (
                      <li>
                        <a class="hit-expand" href={`/?tag=${tag}`} data-tag={tag}>
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="index-mins">{readingMinutes(post.body)} min</p>
              </li>
            ))
          }
        </ol>
        <p class="empty" id="empty" hidden>
          No hay notas con esa etiqueta. Prueba otra o vuelve al archivo completo.
        </p>
      </section>
    </div>
  </main>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const tag = params.get("tag");
  if (tag) {
    const items = document.querySelectorAll<HTMLElement>("[data-tags]");
    let visible = 0;
    items.forEach((item) => {
      const match = (item.dataset.tags ?? "").split(" ").includes(tag);
      item.hidden = !match;
      if (match) visible += 1;
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-tag]").forEach((link) => {
      link.classList.toggle("active", link.dataset.tag === tag);
    });
    const clear = document.getElementById("clear-filter");
    const label = document.getElementById("active-tag");
    const head = document.getElementById("archive-head");
    if (clear && label) {
      clear.hidden = false;
      label.textContent = tag;
    }
    if (head) {
      const kicker = head.querySelector("h2");
      if (kicker) kicker.textContent = "Etiqueta";
    }
    const empty = document.getElementById("empty");
    if (empty) empty.hidden = visible > 0;
    document.querySelector(".feature")?.classList.add("is-filtered");
  }
</script>
